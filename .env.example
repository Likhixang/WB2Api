# Copy to .env and set two distinct randomly generated keys; never commit .env.
WB2API_ADMIN_KEY=
WB2API_API_KEY=
WB2API_BIND_ADDRESS=
WB2API_PORT=
WABI_BASE_URL=https://app.getwabi.ai
WABI_REQUEST_TIMEOUT=120
# Independent video-generation timeout in seconds.
WABI_VIDEO_TIMEOUT=900
WABI_TIME_ZONE=Asia/Shanghai
# Combined request-log budget: active file + backups; 0 disables disk logging.
# Default 20 MiB total / (3 backups + 1 active) = 5 MiB per file.
WB2API_LOG_MAX_BYTES=20971520
WB2API_LOG_BACKUPS=3
